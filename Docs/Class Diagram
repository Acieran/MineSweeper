@startuml
    class Tile {
        - x : int
        - y : int
        - mark : MarkItem
        +Tile(int x, int y)
        +getY() int
        +getX() int
        +open(GameBoard gameBoard) ArrayList<Tile>
        +mark() MarkItem
        +getMark() MarkItem
}
enum MarkItem {
        	NONE
        	MINE
        	QUESTION
        	+next(MarkItem item) MarkItem
        }

    class CleanTile {
        -proximityMineCount : int
        -mineCountSet : boolean
        +CleanTile(int x, int y)
        +getProximityMineCount() int
        +isMineCountSet() boolean
        +getNullTile() CleanTile
        +compareTo(CleanTile other) int
        +toString() String
        +equals(Object obj) boolean
        +countProximityMineCount(Tile[][] smalltile) void
        +open(GameBoard gameBoard) ArrayList<Tile>
        -openProximity(GameBoard gameBoard,ArrayList<Tile> tiles) ArrayList<Tile>
    }

    class Mine {
        +Mine(int x, int y)
        +open(GameBoard gameBoard) ArrayList<Tile>
        +equals(Object obj) boolean
    }

    class Difficulty <<enum>> {
        +Easy
        +Normal
        +Hard
    }
   class GameBoard {
        -height : int
        -width : int
        -mineCount : int
        -board : Tile[][]
        -mineList : ArrayList<Mine>
        -cleanTileList : ArrayList<CleanTile>
        +GameBoard(Difficulty difficulty)
        +GameBoard(int height, int width, int mineCount)
        +GameBoard(int height, int width, int mineCount, boolean setBoard)
        +getCleanTileList() ArrayList<CleanTile>
        +getBoard() Tile[][]
        +getHeight() int
        +getWidth() int
        +getMineCount() int
        +setMineCount(int mineCount) void
        +getMineList() ArrayList<Mine>
        -setMines(int mineCount) void
        -setCleanTiles() void
         -getSmallerBoard(int y, int x) Tile[][]
        -calculateProximityMines() void
        -setBoard() void
    }

    class GameController {
        -timer : Timer
        -seconds : int
        -selectedDifficulty : Difficulty
        -game : GameBoard
        -cleanTileCount : int
        +updateDifficulty(Difficulty newValue) void
        +getSeconds() int
        +getGame() GameBoard
        +getCleanTileCount() int
        +initialize() void
        +startTimer(Label timerLabel) void
        +stopTimer() void
        +stopGame() void
         +openTile(Tile tile, ObservableList<Node> children) void
          +revealAllMines(ObservableList<Node> children) void

    }
   class MineSweeperApplication {
        -gridPane : GridPane
        -timerLabel : Label
         -gameDifficulty : ChoiceBox<Difficulty>
        -restartButton : Button
        -root : VBox
        -mineCountLabel : Label
        -MARKMAP : Map<Tile.MarkItem, String>
        -COLORPICKER : ArrayList<String>
        -height : double
        -width : double
        -gameBoard : GameBoard
        +start(Stage stage) void
        +initialize() void
        -setGameDifficulty() void
        -sizeHandler(double width,double height) void
        +updateDifficulty(Difficulty newDifficulty) void
         +newGame() void
         -createGrid(GameBoard board) void
        -getButton(Tile t) Button
         -initFinals() void
    }

    Tile <|-- CleanTile
    Tile <|-- Mine
    Tile <|.. MarkItem
    GameBoard *-- Tile
    GameBoard *-- Mine
    GameBoard *-- CleanTile
    GameController *-- GameBoard
    MineSweeperApplication *-- GameBoard
     MineSweeperApplication *-- Difficulty
MineSweeperApplication *--* GameController
@enduml